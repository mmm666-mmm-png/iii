# HTTP/WebSocket service.
SERVER_HTTP_ADDR=:8888
CORS_ALLOW_ORIGIN=http://127.0.0.1:5174

# ESP32 UDP ingest.
SERVER_UDP_ADDR=:8888
DEVICE_TOKEN=123456

# Optional Python vision/navigation worker. Keep it on a separate port from the Go backend.
VISION_WORKER_URL=http://127.0.0.1:18082
VISION_FRAME_INTERVAL_MS=450
NAVIGATION_VOICE_DIR=../python_worker/voice
PYTHON_WORKER_PORT=18082

# AMap route planning and Qwen/DashScope voice/AI integration.
AMAP_API_KEY=
AMAP_CITY=枣庄
TACTILE_PAVING_GEOJSON=./data/tactile_paving.geojson
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn
DASHSCOPE_MODEL=qwen3-omni-flash-realtime
DASHSCOPE_VOICE=Ethan
DASHSCOPE_ENABLE_SEARCH=1
DASHSCOPE_INSTRUCTIONS=你是连接在 XIAO ESP32S3 Sense 设备上的多模态语音助手。请结合实时音频和摄像头画面，用简洁、自然、友好的中文回答用户；如果画面或语音信息不足，就明确说明你不确定。
